---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPosts } from '../../lib/sanity';
import { site } from '../../config/site';
const posts = await getPosts();
---
<Base title={`Blog | ${site.name}`} description={`Artículos sobre investigación privada en ${site.city}.`} path="/blog/">
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Blog' }]} />
    <h1>Blog</h1>
    <div class="grid">
      {posts.map((p) => <article class="card"><h2><a href={p.path ?? `/blog/${p.slug}/`}>{p.title}</a></h2>{p.excerpt && <p>{p.excerpt}</p>}</article>)}
    </div>
    {posts.length === 0 && <p class="muted">Próximamente.</p>}
  </div>
</Base>
